{
    "name": "kosmosafive/bitrix-tests",
    "description": "Набор инструментов для тестирования Bitrix Framework",
    "license": "Apache-2.0",
    "homepage": "https://github.com/kosmosafive/bitrix-tests",
    "type": "library",
    "minimum-stability": "stable",
    "keywords": [
        "bitrix",
        "kosmos",
        "test",
        "testing",
        "unit",
        "pest",
        "phpunit",
        "infection"
    ],
    "authors": [
        {
            "name": "Siarhei Buinevich",
            "email": "a5-kosmos@yandex.ru",
            "homepage": "https://t.me/kosmosafive",
            "role": "Author"
        }
    ],
    "require": {
        "php": "^8.3",
        "pestphp/pest": "^4.0.3",
        "pestphp/pest-plugin-type-coverage": "^4.0.2",
        "pestphp/pest-plugin-stressless": "^4.0",
        "infection/infection": "^0.31.2",
        "mockery/mockery": "^1.6.12",
        "symfony/console": "^7.3.2",
        "symfony/dotenv": "^7.3.2",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-profanity": "^4.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1",
        "lendable/composer-license-checker": "^1.2",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "friendsofphp/php-cs-fixer": "^3.86"
    },
    "autoload": {
        "psr-4": {
            "Kosmosafive\\Bitrix\\Tests\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
      "analyse": "vendor/bin/phpstan analyse -c phpstan.neon --ansi",
      "rector:dry-run": "vendor/bin/rector process --config rector.php --dry-run --clear-cache --ansi",
      "rector:process": "vendor/bin/rector process --config rector.php --clear-cache --ansi",
      "license:check": "vendor/bin/composer-license-checker --allow-file .allowed-licenses.php --ansi",
      "dependency:check": "vendor/bin/composer-dependency-analyser --config composer-dependency-analyser.php"
    }
}
